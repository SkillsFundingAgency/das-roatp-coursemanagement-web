@using Humanizer
@using SFA.DAS.DfESignIn.Auth.Extensions
@using SFA.DAS.Roatp.CourseManagement.Web.Models.Standards
@model StandardInformationViewModel

<h1 class="govuk-heading-xl">@Model.CourseDisplayName</h1>
<table class="govuk-table" aria-label="Standard details">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="row">
                Type
            </th>
            <td class="govuk-table__cell">
                @Model.LearningType.ToString().Humanize()
            </td>
        </tr>
        <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="row">
                Sector
            </th>
            <td class="govuk-table__cell">
                @Model.Sector
            </td>
        </tr>
        <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="row">
                LARS code
            </th>
            <td class="govuk-table__cell">
                @Model.LarsCode
            </td>
        </tr>
        @if (Model.IsRegulatedForProvider)
        {
            <tr class="govuk-table__row">
                <th class="govuk-table__header" scope="row">
                    Regulated by
                </th>
                <td class="govuk-table__cell">
                    @Model.RegulatorName
                </td>
            </tr>
        }
        <tr asp-show="@Model.FundingClosing" class="govuk-table__row">
            <th class="govuk-table__header" scope="row">
                Status
            </th>
            <td class="govuk-table__cell">
                <span class="@Model.TagColour">@Model.StatusText</span>
            </td>
        </tr>
        <tr asp-show="@Model.HasLastDateStarts" class="govuk-table__row">
            <th class="govuk-table__header" scope="row">
                Last start date
            </th>
            <td class="govuk-table__cell">
                @Model.LastDateStarts?.ToString("dd MMM yyyy")
            </td>
        </tr>
    </tbody>
</table>
