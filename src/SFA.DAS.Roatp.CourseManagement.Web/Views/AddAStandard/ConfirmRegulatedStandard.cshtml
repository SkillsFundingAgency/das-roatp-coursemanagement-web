@using SFA.DAS.Roatp.CourseManagement.Web.Models.AddAStandard
@model ConfirmNewRegulatedStandardViewModel
@{
    ViewBag.Title = "Confirm regulated standard";
    ViewBag.Description = "";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_validationSummary" />
        <div class="govuk-caption-l">Add a standard</div>
        <partial name="_StandardInformation" for="StandardInformation" />

        <div asp-show="Model.HasLastDateStarts"
             class="govuk-warning-text govuk-!-margin-top-2 govuk-!-margin-bottom-0">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                This course has a last start date set. Once it has passed, you will not be able to:
            </strong>
            <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-6 govuk-!-margin-left-7">
                <li><strong>add new learners</strong></li>
                <li><strong>advertise it on Find apprenticeship training</strong></li>
                <li><strong>submit ILRs for learners who start after this date</strong></li>
            </ul>
            <p class="govuk-warning-text__text govuk-!-margin-top-6">
                You can continue to train learners who are already on the course.
            </p>
        </div>

        <form method="post" asp-route="@RouteNames.PostAddStandardConfirmRegulatedStandard" enctype="multipart/form-data" novalidate>
            <div esfa-validation-marker-for="IsApprovedByRegulator" class="govuk-form-group">
                <span asp-validation-for="IsApprovedByRegulator" class="govuk-error-message"></span>

                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <h1 class="govuk-fieldset__heading">
                            Have you been approved by the regulator to deliver this apprenticeship?
                        </h1>
                    </legend>
                    <div id="IsApprovedByRegulator" class="govuk-radios" data-module="govuk-radios">
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="is-correct-standard-yes" type="radio" value="true"
                                   asp-for="IsApprovedByRegulator" sfa-validationerror-class="form-control-error">
                            <label class="govuk-label govuk-radios__label" for="is-correct-standard-yes">
                                Yes
                            </label>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="is-correct-standard-no" type="radio" value="false"
                                   asp-for="IsApprovedByRegulator" sfa-validationerror-class="form-control-error">
                            <label class="govuk-label govuk-radios__label" for="is-correct-standard-no">
                                No
                            </label>
                        </div>
                    </div>
                </fieldset>
            </div>
            <partial name="~/Views/Standards/StandardsPartials/_RegulatedStandardInfo.cshtml" />
            <div class="govuk-button-group">
                <button id="submit" type="submit" class="govuk-button">Continue</button>
            </div>
        </form>
    </div>
</div>