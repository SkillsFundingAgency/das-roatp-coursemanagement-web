@model SFA.DAS.Roatp.CourseManagement.Web.Models.AddAStandard.NeedApprovalForRegulatedStandardViewModel 
@{
    ViewBag.Title = "Need approval for regulated standard";
    ViewBag.Description = "";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-caption-l">Add a standard</div>
        <h1 class="govuk-heading-l">You need to be approved by the regulator before you can offer this apprenticeship.</h1>
        <p class="govuk-body">This apprenticeship is regulated by the <strong>@Model.RegulatedBy</strong>. Contact them to find out more.</p>
        <div class="govuk-button-group">
            <a href="@Model.SelectAStandardLink" class="govuk-link">Add a different apprenticeship</a>
        </div>
    </div>
</div>