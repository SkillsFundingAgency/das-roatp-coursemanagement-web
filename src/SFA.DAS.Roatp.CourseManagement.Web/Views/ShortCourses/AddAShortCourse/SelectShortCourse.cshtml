@using SFA.DAS.Roatp.CourseManagement.Web.Models.ShortCourses.AddAShortCourse
@model SelectShortCourseViewModel
@{
    ViewBag.Title = $"Select an {Model.LearningTypeLower}";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_validationSummary" />
        <form method="post" asp-route="@RouteNames.SelectShortCourse" enctype="multipart/form-data" novalidate>

            <input type="hidden" asp-for="LearningType" />
            <h1 class="govuk-label-wrapper govuk-!-margin-bottom-8">
                <label class="govuk-label govuk-label--xl" asp-for="SelectedLarsCode">
                    Add an @Model.LearningTypeLower
                </label>
            </h1>

            <div esfa-validation-marker-for="SelectedLarsCode" class="govuk-form-group">
                <div class="govuk-hint">
                    Start typing the @Model.LearningTypeLower name or code
                </div>
                <span asp-validation-for="SelectedLarsCode" class="govuk-error-message"></span>
                <select asp-for="SelectedLarsCode" asp-items="@Model.ShortCourses" class="govuk-select app-autocomplete">
                    <option value="" disabled selected></option>
                </select>
            </div>

            <div class="govuk-button-group govuk-!-margin-bottom-8">
                <button id="submit" type="submit" class="govuk-button">Continue</button>
            </div>

            <h2 class="govuk-heading-m">If you cannot find an @Model.LearningTypeLower</h2>
            <p>Some @Model.LearningTypeLowerPlural may not appear because they are:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>restricted to certain providers</li>
                <li>being decommissioned</li>
            </ul>

        </form>
    </div>
</div>