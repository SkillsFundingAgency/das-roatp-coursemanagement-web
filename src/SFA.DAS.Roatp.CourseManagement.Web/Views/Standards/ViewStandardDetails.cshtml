@using SFA.DAS.Roatp.CourseManagement.Web.Common.Constants
@using SFA.DAS.Roatp.CourseManagement.Web.Models.Standards
@model StandardDetailsViewModel
@{
    ViewBag.Title = "Standard details";
}

@section breadcrumb
{
    @await Html.PartialAsync("_Breadcrumbs", Model.Breadcrumbs)
}

@if (Model.MissingInfoBannerViewModel.HasMissingRegulatorApproval || Model.MissingInfoBannerViewModel.HasMissingLocationAndRegulatorApproval)
{
    <partial name="~/Views/Standards/StandardsPartials/_MissingInfoBanner.cshtml" for="MissingInfoBannerViewModel" />
}

<div asp-show="Model.StandardRequiresMoreInfo" class="govuk-grid-row govuk-warning-text govuk-!-margin-bottom-4">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            This apprenticeship is missing a training option. It will not show on Find apprenticeship training until you add one. <a href="@Model.EditLocationOptionUrl" class="govuk-link">Add a training option.</a>
        </strong>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-caption-l">Manage a standard</div>
        <partial name="_StandardInformation" for="StandardInformation" />
        <partial name="_LastStartDateWarning" model="Model.StandardInformation.FundingClosing" />
        <partial name="_LastStartDatePassedWarning" model="Model.StandardInformation.FundingClosed" />
    </div>
</div>

<div asp-show ="!@Model.StandardInformation.FundingClosed" class="govuk-grid-row govuk-!-margin-top-8">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_StandardContactInformation" for="ContactInformation" />
        <p class="govuk-body">
            <a href="@Model.EditContactDetailsUrl" class="govuk-link">
                Update these contact details
            </a>
        </p>
    </div>
</div>


<div asp-show ="!@Model.StandardInformation.FundingClosed" class="govuk-grid-row govuk-!-margin-top-8">
    <div class="govuk-grid-column-two-thirds">
        <table class="govuk-table" aria-label="Where you deliver this standard">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th class="govuk-table__header das-table-cell-width-80" scope="col">
                        <h2 class="govuk-heading-l">
                            Training options
                        </h2>
                    </th>
                    <th class="govuk-table__header das-table-cell-width-20" scope="col">
                        <span class="govuk-visually-hidden">Action</span>
                    </th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        @Html.Raw(Model.LocationSummary)
                    </td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">
                        <a href="@Model.EditLocationOptionUrl" class="govuk-link govuk-link--no-visited-state">
                            Change<span class="govuk-visually-hidden"> where you deliver this standard</span>
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>

        @if (Model.ProviderCourseLocations.Any())
        {
            <table class="govuk-table" aria-label="List of training locations">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th class="govuk-table__header das-table-cell-width-50" scope="col"> Venue name </th>
                        <th class="govuk-table__header das-table-cell-width-50" scope="col"> Delivery method</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var location in Model.ProviderCourseLocations)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">
                                @location.LocationName
                            </td>
                            <td class="govuk-table__cell">
                                @location.DeliveryMethod.ToSummary()
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="govuk-body govuk-!-margin-bottom-8">
                <a href="@Model.EditTrainingLocationsUrl" class="govuk-link govuk-link--no-visited-state">Edit training locations</a>
            </p>
        }

        @if (Model.SubRegionCourseLocations.Any())
        {
            <p class="govuk-body">
                Training can be delivered on site at the employer's address, as long as they are within these regions:
            </p>

            foreach (var region in Model.Regions())
            {
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                <h3 class="govuk-heading-m">@region.Key</h3>
                <ul class="govuk-list govuk-grid-row">
                    @foreach (var location in region.OrderBy(x => x.SubregionName))
                    {
                        <li class="govuk-grid-column-one-half">
                            @location.SubregionName
                        </li>
                    }
                </ul>
            }
            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
            <p class="govuk-body">

                <a href="@Model.EditProviderCourseRegionsUrl" class="govuk-link govuk-link--no-visited-state">
                    Edit these regions
                </a>
            </p>
        }
    </div>
</div>

<div class="govuk-grid-row govuk-!-margin-top-8">
    <div class="govuk-grid-column-two-thirds">
        <h4 class="govuk-heading-l">
            Delete this course
            </h4>
        <p class="govuk-body">
            Deleting a course from your offering will stop you from claiming government funding for it. You will not be able to submit any Individualised Learner Records (ILRs) for it.
            </p>
        <p class="govuk-body">
            If you choose to delete it, it will be removed from your account and no longer show on Find apprenticeship training.
            </p>
        <div class="govuk-inset-text">
            <p class="govuk-body">
                <strong>Do not delete this course if you still have learners on it, or if you have outstanding ILR submissions for previous learners.</strong>
            </p>

            <p class="govuk-body">
                <strong>This apprenticeship must stay in your offering if you want to receive government funding for it.</strong>
            </p>

            <p class="govuk-body">
                <strong>Find out more about <a href="@ExternalLinks.FindOutAboutIlrSubmissionsLink" target="_blank" class="govuk-link">making ILR submissions</a>.</strong>
            </p>
        </div>
        <div class="govuk-button-group">
            <a id="submit" href="@Model.DeleteStandardUrl" class="govuk-button govuk-button--secondary">Delete apprenticeship</a>
        </div>
    </div>
</div>

<div class="govuk-grid-row govuk-!-margin-top-8">
    <div class="govuk-grid-column-two-thirds">
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
        <p class="govuk-body">
            <a href="@Model.BackUrl" class="govuk-link govuk-link--no-visited-state">
                Back to manage your standards
            </a>
        </p>
    </div>
</div>