@using SFA.DAS.Roatp.CourseManagement.Web.Models.Standards
@using SFA.DAS.Roatp.CourseManagement.Web.Services
@model StandardListViewModel
@{
    ViewBag.Title = "Standards";
}

@section breadcrumb
{
    @await Html.PartialAsync("_Breadcrumbs", Model.Breadcrumbs)
}

@if (Model.ShowNotificationBannerDeleteStandard)
{
    <partial name="~/Views/Standards/StandardsPartials/_StandardDeleteNotificationBanner.cshtml" />
}
@if (Model.ShowNotificationBannerAddStandard)
{
    <partial name="~/Views/Standards/StandardsPartials/_StandardAddNotificationBanner.cshtml" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-5">Manage your apprenticeships</h1>
    </div>
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body">Add, remove or change the courses you advertise on Find apprenticeship training.</p>
        <p class="govuk-body">If you want to claim government funding for a course, it must be added here.</p>
    </div>
</div>

<div class="app-action-panel govuk-!-margin-bottom-8 govuk-!-margin-top-2">
    <h2 class="govuk-heading-l">Add an apprenticeship</h2>
    <p class="govuk-body">Add a new apprenticeship to your offering on Find apprenticeship training. Courses must be added to your account before you can claim government funding for them.</p>
    <p class="govuk-body">
        <a href="@Model.AddAStandardLink" class="govuk-button">
            Add apprenticeship
        </a>
    </p>
</div>

<div asp-show="@Model.ShowCourseMissingInfo" class="app-action-panel govuk-!-margin-bottom-8 govuk-!-margin-top-2">
    <h3 class="govuk-heading-l">Courses not showing on Find apprenticeship training</h3>
    <p class="govuk-body">If you want to advertise these courses to employers, you need to update them.</p>
    <div asp-show="@Model.ShowSingleCourseMissingInfo">
        <h4 class="govuk-heading-m">
            Course with missing information
        </h4>
        <ul class="govuk-list">
            @foreach (var standard in Model.Standards
                .Where(s => s.StandardRequiresMoreInfo))
            {
                <li>
                    <a class="govuk-link" href="@standard.StandardUrl">
                        @standard.CourseDisplayName
                    </a>
                </li>
            }
        </ul>
    </div>
    <div asp-show="@Model.ShowListOfCoursesMissingInfo" class="govuk-accordion" data-module="govuk-accordion" id="course-missing-info-accordion">
        <div class="govuk-accordion__section">
            <div class="govuk-accordion__section-header">
                <h4 class="govuk-accordion__section-heading">
                    <span class="govuk-accordion__section-button" id="course-missing-info-accordion-heading-1">
                        Courses with missing information (@Model.CoursesMissingInfoCount)
                    </span>
                </h4>
            </div>
            <div id="course-missing-info-accordion-content-1" class="govuk-accordion__section-content" style="padding-top: 0;">
                <ul class="govuk-list">
                    @foreach (var standard in Model.Standards
                        .Where(s => s.StandardRequiresMoreInfo))
                    {
                        <li style="padding-bottom: 15px;">
                            <a class="govuk-link" href="@standard.StandardUrl">
                                @standard.CourseDisplayName
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-6">

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds govuk-!-margin-bottom-0">
        <h5 class="govuk-heading-l">Your apprenticeships</h5>
        <p asp-show="Model.HasNoCourses" class="govuk-body">
            There are currently no courses, add one above.
        </p>
        <p asp-show="Model.HasCourses" class="govuk-body">
            This is a list of apprenticeships you currently claim government funding for.
        </p>
        <details asp-show="Model.HasCourses" class="govuk-details">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                    What do the funding statuses mean?
                </span>
            </summary>
            <div class="govuk-details__text">
                <p>The Apprenticeship Service (AS) is responsible for managing the courses training providers can deliver and claim funding for.</p>
                <p>Sometimes, we may choose to limit who can deliver a course. We also may decide to stop all providers from offering it. For example, when a course is being defunded.</p>
                <p>Funding statuses help you understand if a course is:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>closing to new government funded learners soon</li>
                    <li>no longer funded by the government</li>
                </ul>
            </div>
        </details>
    </div>
</div>


<div asp-show="Model.HasCourses" class="govuk-grid-row govuk-!-margin-top-6" id="@ViewStandardsFilterBuilder.ViewStandardsFilterResultsFragment">
    <div class="govuk-grid-column-one-third">
        @await Html.PartialAsync("_filters", Model.Filters)
    </div>
    <div asp-show="@Model.HasFilteredResults" class="govuk-grid-column-two-thirds">
        <div class="app-results-header govuk-!-margin-bottom-3">
            <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0">@Model.FilteredCourseCount @(Model.FilteredCourseCount == 1 ? "course" : "courses")</p>
            <p class="govuk-body govuk-!-margin-bottom-0">
                Sorted by: <span class="govuk-!-font-weight-bold">Name of course</span>
            </p>
        </div>

    <ul class="govuk-list app-results-list app-results-list--bordered">
        @foreach (var course in Model.FilteredCourses)
        {
            <li class="app-results-list__item">

                <div class="govuk-!-margin-bottom-2">
                    <div asp-show="@course.FundingClosing">
                        <strong class="govuk-tag govuk-tag--orange govuk-!-margin-bottom-2">
                            Funding closing for new starts
                        </strong>
                    </div>

                    <div asp-show="@course.FundingClosed">
                        <strong class="govuk-tag govuk-tag--grey govuk-!-margin-bottom-2">
                            Funding closed for new starts
                        </strong>
                    </div>
                </div>

                <div class="app-results-list__content">
                    <h6 class="govuk-heading-m govuk-!-margin-bottom-1">
                        <a class="govuk-link govuk-link--no-visited-state"
                            href="@course.StandardUrl">
                            @course.CourseDisplayName
                        </a>
                    </h6>
                    <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-1">
                        <span class="govuk-hint">LARS Code:</span>
                        @course.LarsCode
                        </p>
                    <div asp-show="@course.FundingClosing"
                            class="govuk-!-margin-top-2 govuk-!-margin-bottom-0">

                        <p class="govuk-body govuk-!-margin-bottom-1">
                            <span class="govuk-hint">Funding status:</span>
                            We've added a last start date for learners to this course.
                            You can claim funding for new learners enrolled up until this date.
                        </p>

                        <p class="govuk-body govuk-!-margin-bottom-0">
                            <span class="govuk-hint">Last start date:</span>
                            @course.LastDateStarts?.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div asp-show="@course.FundingClosed"
                            class="govuk-!-margin-top-2 govuk-!-margin-bottom-0">

                        <p class="govuk-body govuk-!-margin-bottom-1">
                            <span class="govuk-hint">Funding status:</span>
                            We've closed this apprenticeship to new starts.
                            This means you can no longer claim funding for any learners you enrol.
                        </p>

                        <p class="govuk-body govuk-!-margin-bottom-0">
                            <span class="govuk-hint">Last start date:</span>
                            @course.LastDateStarts?.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div asp-show="@course.StandardRequiresMoreInfo" class="govuk-warning-text govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                        <strong class="govuk-warning-text__text">
                            <span class="govuk-visually-hidden">Warning</span>
                            This apprenticeship is missing information, which means it's not showing on Find apprenticeship training. Update your details to advertise it.
                        </strong>
                    </div>
                </div>
            </li>
            }
        </ul>            
    </div>
    <div asp-show="Model.HasNoFilteredResults" class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-l">No results</h2>
        <p class="govuk-body">There are no courses that match your search.</p>
        <p class="govuk-body">You may need to:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>clear filters you've selected</li>
            <li>check your spelling or enter another search term and try again</li>
        </ul>
        <p class="govuk-body">Change your search using the filters on this page.</p>
    </div>
</div>