@using SFA.DAS.Roatp.CourseManagement.Web.Models.Standards
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using SFA.DAS.DfESignIn.Auth.Extensions
@model ConfirmDeleteStandardViewModel

@{
    ViewBag.Title = "Confirm deletion";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_validationSummary" /> 
        <span class="govuk-caption-l">Manage an apprenticeship</span>
        <h1 class="govuk-heading-xl">Are you sure you want to delete this apprenticeship?</h1>
        <form method="post" asp-route="@RouteNames.PostConfirmDeleteStandard" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="StandardInformation.LarsCode" />

            <p>Deleting an apprenticeship will remove it from your account. This means it will no longer show on Find apprenticeship training.</p>
            <p>Deleting it will also stop you from submitting Individualised Learning Records (ILR) for government funding.</p>

            <table class="govuk-table">
                <caption class="govuk-visually-hidden">Details of the standard</caption>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            Standard
                        </th>
                        <td class="govuk-table__cell">
                            @Model.StandardInformation.CourseDisplayName
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            ST Code
                        </th>
                        <td class="govuk-table__cell">
                            @Model.StandardInformation.IfateReferenceNumber
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            Type
                        </th>
                        <td class="govuk-table__cell">
                            @Model.StandardInformation.LearningType.GetDescription()
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            Sector
                        </th>
                        <td class="govuk-table__cell">
                            @Model.StandardInformation.Sector
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            LARS code
                        </th>
                        <td class="govuk-table__cell">
                            @Model.StandardInformation.LarsCode
                        </td>
                    </tr>
                @if (Model.StandardInformation.IsRegulatedForProvider)
                {
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            Regulator
                        </th>
                        <td class="govuk-table__cell">
                            @Model.StandardInformation.RegulatorName
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="govuk-warning-text">
              <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
              <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Do not delete this course if you currently have active learners on it. It needs to stay in your offering to claim government funding.
              </strong>
            </div>

            <div class="govuk-button-group">
                <button id="DeleteStandard" class="govuk-button govuk-button--warning" data-module="govuk-button" data-disable-on-submit="true">
                    Delete apprenticeship
                </button>
            </div>
        </form>
    </div>
</div>